# OpenRouter (LLM calls, and Audio Studio TTS: Gemini 3.8 Flash TTS first)
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional overrides
# OPENROUTER_MODEL=minimax/minimax-m2.5
# OPENROUTER_FALLBACK_MODEL=z-ai/glm-5

# Gemini API (Audio Studio: 2.5 Pro TTS fallback, script preparation)
GEMINI_API_KEY=your_gemini_api_key
# Optional model/pricing overrides live in wrangler.jsonc
# (TTS_MODEL_MONOLOGUE, TTS_MODEL_DIALOGUE, TTS_MODEL_FINAL, ...).
# Live check of both modes: npm run audio:probe

# Resend (email)
RESEND_API_KEY=your_resend_api_key

# App
APP_URL=https://promptomatik.com
APP_SECRET=generate_a_random_secret_for_sessions

# Cloudflare (set via wrangler.jsonc / dashboard)
# D1_DATABASE_ID=your_d1_database_id
# KV_NAMESPACE_ID=your_kv_namespace_id
