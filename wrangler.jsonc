{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptomatik",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-02-10",
  "routes": [
    { "pattern": "studio.teachinspire.me", "custom_domain": true },
    { "pattern": "promptomatik.com", "custom_domain": true }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "https://studio.teachinspire.me",
    "TTS_MODEL_DRAFT": "gemini-2.5-flash-preview-tts",
    "TTS_MODEL_FINAL": "gemini-2.5-pro-preview-tts",
    "TTS_PRICE_AUDIO_PER_1M_TOKENS_DRAFT": "10",
    "TTS_PRICE_AUDIO_PER_1M_TOKENS_FINAL": "20",
    "LLM_MODEL_PREP": "gemini-2.5-flash",
    // Tier-aware model routing (worker/lib/interview-jobs.ts → llmModels):
    // participant jobs run OPENROUTER_MODEL first with the FALLBACK as backup;
    // free-tier jobs run OPENROUTER_FALLBACK_MODEL (economy) first with
    // OPENROUTER_MODEL as backup. The primary/fallback semantics intentionally
    // invert per tier — this is cost routing, not a bug.
    "OPENROUTER_MODEL": "anthropic/claude-sonnet-4.6",
    "OPENROUTER_FALLBACK_MODEL": "moonshotai/kimi-k2.5",
    "DOCS_MODEL": "google/gemini-3.1-pro-preview",
    "STRIPE_PRICE_PACK_60": "price_1Tp9T2RAS2gqu38Be86PfNkm",
    "STRIPE_PRICE_PACK_180": "price_1Tp9T2RAS2gqu38BW79nmvIe"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptomatik-db",
      "database_id": "56ffb3e4-698b-47c0-86f1-256a999e5e0e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "3678a6b34e5e4ab79cc93303fb091593",
      "preview_id": "3678a6b34e5e4ab79cc93303fb091593"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "teachinspire-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTERVIEW_JOBS_QUEUE",
        "queue": "interview-jobs"
      },
      {
        "binding": "AUDIO_GENERATION_QUEUE",
        "queue": "audio-generation"
      },
      {
        "binding": "DOCUMENT_JOBS_QUEUE",
        "queue": "document-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "interview-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 5
      },
      {
        "queue": "audio-generation",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 5
      },
      {
        "queue": "document-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 5
      }
    ]
  }
}
